{
  "title": "SyncFlow SRE Dashboard",
  "uid": "syncflow-sre",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "SLO: API Availability (99.9%)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 3 },
      "targets": [{
        "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"2\\\\d\\\\d|3\\\\d\\\\d\"}[30d])) / sum(rate(http_server_requests_seconds_count[30d]))) * 100",
        "legendFormat": "Availability"
      }]
    },
    {
      "id": 2,
      "title": "SLO: Sync Success Rate (99.5%)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 3 },
      "targets": [{
        "expr": "(sum(rate(syncflow_sync_events_processed_total[30d])) / (sum(rate(syncflow_sync_events_processed_total[30d])) + sum(rate(syncflow_sync_errors_total[30d])))) * 100",
        "legendFormat": "Sync Success"
      }]
    },
    {
      "id": 3,
      "title": "Error Budget (30d rolling)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 3 },
      "targets": [{
        "expr": "1 - (sum(rate(http_server_requests_seconds_count{status=~\"5\\\\d\\\\d\"}[30d])) / sum(rate(http_server_requests_seconds_count[30d]))) / 0.001",
        "legendFormat": "Error Budget"
      }]
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 3, "w": 6, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
        "legendFormat": "P99"
      }]
    },
    {
      "id": 5,
      "title": "Events Processing Rate",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 3, "w": 6, "h": 4 },
      "targets": [
        { "expr": "rate(syncflow_cdc_events_total[5m])", "legendFormat": "CDC Events/s" },
        { "expr": "rate(syncflow_sync_events_processed_total[5m])", "legendFormat": "Sync Events/s" }
      ]
    },
    {
      "id": 6,
      "title": "Queue Depth",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 6, "h": 3 },
      "targets": [{ "expr": "syncflow_workflow_queue_size", "legendFormat": "Queue" }]
    },
    {
      "id": 7,
      "title": "Active Agents per Region",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 7, "w": 6, "h": 3 },
      "targets": [{ "expr": "sum by(region) (syncflow_agents_online)", "legendFormat": "{{region}}" }]
    }
  ]
}